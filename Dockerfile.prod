FROM denoland/deno:2.9.2

ARG GIT_REVISION
ENV DENO_DEPLOYMENT_ID=${GIT_REVISION}

WORKDIR /app

# Copy dependency files first for better layer caching
COPY deno.json deno.lock ./

# Pre-populate the deno cache (top-level imports only). --no-lock is crucial:
# plain `deno cache deno.json` rewrites deno.lock to a partial graph (drops
# jsr/redirects sections), breaking fresh's jsr:->https: resolution during
# `deno task build`.
RUN deno cache --no-lock deno.json

# Copy the rest of the application code
COPY . .

# Build the application
RUN deno task build

# Cache the server entry point
RUN deno cache _fresh/server.js

EXPOSE 8000

CMD ["deno", "task", "start"]

