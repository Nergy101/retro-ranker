FROM denoland/deno:2.9.2

ARG GIT_REVISION
ENV DENO_DEPLOYMENT_ID=${GIT_REVISION}

WORKDIR /app

# Copy dependency files first for better layer caching
COPY deno.json deno.lock ./

# NOTE: deliberately no `deno cache deno.json` here — it rewrites deno.lock
# to a partial graph (drops jsr/redirects sections), which breaks the fresh
# vite plugin's jsr:->https: resolution during `deno task build`.

# Copy the rest of the application code
COPY . .

# Build the application
RUN deno task build

# Cache the server entry point
RUN deno cache _fresh/server.js

EXPOSE 8000

CMD ["deno", "task", "start"]

# docker buildx build . -f Dockerfile.prod -t retro-ranker:latest --load
# docker run -t -i -p 8000:8000 retro-ranker:latest

